# ==========================================================================
# React (Vite) SPA - Hostinger shared hosting
# Copy this file to:  /home/u652379655/domains/digitalsafar.tech/public_html/sms/.htaccess
# Filename on the server MUST be exactly:  .htaccess
# ==========================================================================

# --- 1. Force HTTPS (must come first) ---------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- 2. Block access to dotfiles (.env, .git, etc.) -------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --- 3. SPA fallback for React Router ---------------------------------------
# Without this, refreshing https://sms.digitalsafar.tech/students returns 404.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Never rewrite a real file or a real directory
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the React entry point
    RewriteRule . /index.html [L]
</IfModule>

# --- 4. Do not cache index.html so new deploys appear immediately -----------
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                "access plus 0 seconds"
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 6 months"
    ExpiresByType image/png                "access plus 6 months"
    ExpiresByType image/jpeg               "access plus 6 months"
    ExpiresByType font/woff2               "access plus 1 year"
</IfModule>

# --- 5. Compression ---------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- 6. Basic security headers ---------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
</IfModule>

# --- 7. Uploaded and temporary files ----------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:uploads?|tmp|temp|storage)/ - [F,L]
</IfModule>
